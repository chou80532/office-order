# Emulator-only defaults. The app ignores Firebase project IDs while emulator mode is enabled.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-office-lunch.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-office-lunch
VITE_FIREBASE_STORAGE_BUCKET=demo-office-lunch.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Optional: Web Push certificate key (Firebase Console > Project settings > Cloud Messaging). Leave empty to hide browser notifications.
VITE_FIREBASE_VAPID_KEY=
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
